# VitalBite AI - Environment Configuration Template
# Copy this file to .env or configure in Streamlit Secrets (.streamlit/secrets.toml)

# Google Gemini API Key
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Auth & PostgreSQL Database Configuration
# Get your credentials from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# USDA FoodData Central API Key (Optional for extended food lookups)
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your_usda_api_key_here

# Opt-in Mock Database Mode (Strictly for local development/offline testing)
# MUST BE false or unset in production
VITALBITE_ALLOW_MOCK_DB=false
