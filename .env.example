# VitalBite AI - Environment Configuration Template
# Copy this file to .env or configure in Streamlit Secrets (.streamlit/secrets.toml)

## Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Auth & PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# USDA FoodData Central API Key
USDA_FDC_API_KEY=your_usda_api_key_here

# Opt-in Mock Database Mode
VITALBITE_ALLOW_MOCK_DB=false
